{
  "name": "@dfine-io-gmbh/semantic-mcp",
  "version": "0.2.0",
  "description": "Semantic codebase search MCP server — embeds project chunks into a local SQLite vector store and exposes natural-language search over them.",
  "license": "MIT",
  "author": "dfine.io <support@dfine.io>",
  "homepage": "https://github.com/dfine-io/dfine-semantic-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dfine-io/dfine-semantic-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/dfine-io/dfine-semantic-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "semantic-search",
    "embeddings",
    "sqlite-vec",
    "transformers",
    "claude-code"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "dfine-semantic-mcp": "./build/index.js"
  },
  "files": [
    "build",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node build/index.js",
    "test": "tsc && node --test test/*.test.mjs",
    "lint:dlint": "dlint --format compact",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "check": "tsc && pnpm lint:dlint && prettier --check \"src/**/*.ts\"",
    "prepublishOnly": "rm -rf build tsconfig.tsbuildinfo && tsc && chmod +x build/index.js"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.3",
    "ignore": "^7.0.6",
    "sqlite-vec": "^0.1.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@dfine-io-gmbh/dlint": "^1.5.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
